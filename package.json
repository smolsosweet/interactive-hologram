{
  "name": "delphora",
  "version": "1.0.3",
  "description": "Interactive 3D Solar System Hologram with hand gesture control",
  "author": "smolsosweet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "release:win": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.delphora.solarsystem",
    "productName": "Delphora",
    "publish": [
      {
        "provider": "github",
        "owner": "smolsosweet",
        "repo": "interactive-hologram"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "electron-updater": "^6.8.9",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1"
  }
}
